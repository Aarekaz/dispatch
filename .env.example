# Convex
NEXT_PUBLIC_CONVEX_URL=
CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=

# App URLs
SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth (Better Auth + Google OAuth)
BETTER_AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_EMAIL_FROM=
RESEND_API_KEY=

# Runtime
DISPATCH_RUNTIME_KIND=opencode
OPENCODE_BASE_URL=
OPENCODE_SERVER_PASSWORD=
OPENROUTER_API_KEY=
# Leave unset for the stable default path. Set to 1 only when
# validating Dispatch's custom OpenCode tools like announce_artifact.
DISPATCH_ENABLE_OPENCODE_CUSTOM_TOOLS=

# Daytona
DAYTONA_API_KEY=
DAYTONA_API_URL=
DAYTONA_TARGET=

# Tool integrations
COMPOSIO_API_KEY=

# ── Branding (env-driven, see lib/config/branding.ts) ─────
#
# Display name for the chat bot across every supported platform.
# Set per Vercel environment so dev and prod use different Slack
# apps without code changes:
#   - Preview:    NEXT_PUBLIC_BOT_NAME=Dispatch-Dev
#   - Production: NEXT_PUBLIC_BOT_NAME=Dispatch
#
# Must match the `display_information.name` and
# `features.bot_user.display_name` in the corresponding Slack app
# manifest at api.slack.com/apps. Defaults to "Dispatch" if unset.
NEXT_PUBLIC_BOT_NAME=

# Chat SDK adapters
#
# Slack — multi-workspace OAuth.
# One-time setup: create a Slack app at https://api.slack.com/apps,
# enable OAuth + Permissions, set the redirect URL to
# {SLACK_REDIRECT_URI}, then paste the credentials below.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Must match the redirect URL registered in your Slack app config.
# Local dev default works because Slack OAuth allows http://localhost.
SLACK_REDIRECT_URI=http://localhost:3000/api/slack/callback

TELEGRAM_BOT_TOKEN=

# Shared secret used by Vercel webhook handlers when calling
# Convex public-but-secret-gated functions (chatState, integrations.*,
# chat.persistMessagesFromWebhook). Generate with: openssl rand -hex 32
CHAT_STATE_INTERNAL_SECRET=

# ── Cron job dispatcher ──────────────────────────────
#
# `/api/cron/tick` dispatches due agent automations. Any scheduler can
# call it, including system cron, GitHub Actions, a platform scheduler,
# or Vercel Cron if you opt in with `vercel.example.json`.
#
# It needs two secrets:
#
# 1. CRON_SECRET — shared with your scheduler. The scheduler sends
#    `Authorization: Bearer $CRON_SECRET` so the endpoint can reject
#    direct unauthenticated requests. Generate your own value for
#    self-hosting. Some platforms may generate or inject this for you.
#
# 2. CRON_INTERNAL_SECRET — you generate this one manually. It's the
#    secret the cron endpoint uses when calling Convex's internal
#    functions (`agentCrons.listDue`, `agentCrons.markRun`,
#    `runs.logInternal`, `agents.getInternal`, `credits.checkInternal`).
#    Same pattern as CHAT_STATE_INTERNAL_SECRET — public Convex
#    functions that check a shared secret because the cron runner
#    has no Convex Auth session.
#
#    Generate with: openssl rand -hex 32
#
#    Set it in .env.local for local testing (call the endpoint
#    manually via curl with a matching Authorization header) and in
#    whichever production environment runs Dispatch.
#    Without this, the cron endpoint returns 500 and nothing runs.
CRON_SECRET=

# HMAC key used to derive a distinct Telegram webhook secret per agent.
TELEGRAM_WEBHOOK_SECRET=

# Public email/password registration is disabled unless explicitly enabled.
ALLOW_PUBLIC_SIGNUP=false

# Transactional cap enforced before a Daytona sandbox is provisioned.
MAX_AGENTS_PER_USER=3

# Shared only by the Next.js Slack bind route and Convex binding mutation.
SLACK_BIND_INTERNAL_SECRET=
CRON_INTERNAL_SECRET=

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Preview / deployment helpers
VERCEL_AUTOMATION_BYPASS_SECRET=
VERCEL_PROJECT_PRODUCTION_URL=

# ── Global banner ────────────────────────────────────────
#
# Shows a banner across the top of every page (dashboard + sign-in).
# Controlled entirely by env vars — no code change or redeploy needed.
# Clear NEXT_PUBLIC_BANNER_TEXT to hide the banner.
#
# Types:
#   info         — dark blue, label "Beta" (default)
#   warning      — amber, label "Warning"
#   error        — red, label "Outage"
#   announcement — purple, label "New"
#
# Examples:
#   Beta banner:
#     NEXT_PUBLIC_BANNER_TEXT=Dispatch is in beta. Things may change as we ship improvements.
#     NEXT_PUBLIC_BANNER_TYPE=info
#
#   Outage banner:
#     NEXT_PUBLIC_BANNER_TEXT=We're experiencing issues with Slack delivery. Our team is on it.
#     NEXT_PUBLIC_BANNER_TYPE=error
#
#   Feature announcement:
#     NEXT_PUBLIC_BANNER_TEXT=New: Gmail and GitHub triggers for automations.
#     NEXT_PUBLIC_BANNER_TYPE=announcement
#     NEXT_PUBLIC_BANNER_DISMISSIBLE=true
#     NEXT_PUBLIC_BANNER_LINK_TEXT=Set them up →
#     NEXT_PUBLIC_BANNER_LINK_URL=/automations
#
NEXT_PUBLIC_BANNER_TEXT=
NEXT_PUBLIC_BANNER_TYPE=info
NEXT_PUBLIC_BANNER_DISMISSIBLE=false
NEXT_PUBLIC_BANNER_LINK_TEXT=
NEXT_PUBLIC_BANNER_LINK_URL=
